<mxfile host="app.diagrams.net">
  <diagram id="usecase" name="Use Case Diagram - RikkeiLogistics">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1000" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="boundary" value="He thong RikkeiLogistics" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="260" y="40" width="580" height="600" as="geometry" />
        </mxCell>

        <!-- Actor -->
        <mxCell id="actor" value="Khach hang" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="60" height="90" as="geometry" />
        </mxCell>

        <!-- Use cases -->
        <mxCell id="ucLogin" value="Dang nhap" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ucOrder" value="Dat don hang" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="330" y="290" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ucLe" value="Dat don hang le" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="600" y="230" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ucSi" value="Dat don hang si\n(so luong lon)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="600" y="340" width="180" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ucFast" value="Giao hang hoa toc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="320" y="470" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Associations -->
        <mxCell id="a1" style="html=1;endArrow=none;" edge="1" parent="1" source="actor" target="ucLogin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="html=1;endArrow=none;" edge="1" parent="1" source="actor" target="ucOrder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Include: Dat don hang ..> Dang nhap -->
        <mxCell id="inc1" value="&lt;&lt;include&gt;&gt;" style="html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="ucOrder" target="ucLogin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Extend: Giao hang hoa toc ..> Dat don hang -->
        <mxCell id="ext1" value="&lt;&lt;extend&gt;&gt;" style="html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="ucFast" target="ucOrder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Generalization: ucLe -> ucOrder, ucSi -> ucOrder -->
        <mxCell id="gen1" style="html=1;endArrow=block;endFill=0;endSize=16;" edge="1" parent="1" source="ucLe" target="ucOrder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gen2" style="html=1;endArrow=block;endFill=0;endSize=16;" edge="1" parent="1" source="ucSi" target="ucOrder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
